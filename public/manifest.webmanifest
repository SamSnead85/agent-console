{
  "name": "Agent Console · LockedIn Labs",
  "short_name": "Agent Console",
  "description": "Agent Console by LockedIn Labs: sessions, tokens, cache reads and writes, models and spend across every machine you connect.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
