class AgentConsole < Formula
  desc "Local fleet accounting for Claude Code and Codex"
  homepage "https://github.com/SamSnead85/agent-console"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/SamSnead85/agent-console/releases/download/v@VERSION@/agent-console-darwin-arm64.tar.gz"
      sha256 "@DARWIN_ARM64_SHA@"
    end
    on_intel do
      url "https://github.com/SamSnead85/agent-console/releases/download/v@VERSION@/agent-console-darwin-x64.tar.gz"
      sha256 "@DARWIN_X64_SHA@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/SamSnead85/agent-console/releases/download/v@VERSION@/agent-console-linux-arm64.tar.gz"
      sha256 "@LINUX_ARM64_SHA@"
    end
    on_intel do
      url "https://github.com/SamSnead85/agent-console/releases/download/v@VERSION@/agent-console-linux-x64.tar.gz"
      sha256 "@LINUX_X64_SHA@"
    end
  end

  def install
    bin.install "agent-console"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/agent-console --version")
  end
end
