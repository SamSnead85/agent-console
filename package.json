{
  "name": "@lockedinlabs/agent-console",
  "version": "0.1.0",
  "description": "Local observability for Claude Code and Codex: sessions, subagents, token usage, model costs, and delivery evidence.",
  "keywords": [
    "claude-code",
    "codex",
    "ai-coding-agents",
    "observability",
    "dashboard",
    "token-usage",
    "cost-tracking",
    "developer-tools",
    "cli",
    "zero-dependencies"
  ],
  "type": "module",
  "bin": {
    "agent-console": "./bin/agent-console.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "lib/",
    "public/",
    "server.js",
    "scripts/",
    "docs/",
    "PROVENANCE.md"
  ],
  "scripts": {
    "start": "node bin/agent-console.mjs",
    "test": "node scripts/test.mjs",
    "pack:check": "npm pack --dry-run --json",
    "smoke:pack": "node scripts/pack-smoke.mjs"
  },
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamSnead85/agent-console.git"
  },
  "homepage": "https://github.com/SamSnead85/agent-console#readme",
  "bugs": {
    "url": "https://github.com/SamSnead85/agent-console/issues"
  }
}
